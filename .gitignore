# ===========================
# OS が自動で作るファイル
# ===========================
.DS_Store
Thumbs.db
desktop.ini

# ===========================
# IDE / Claude /  エディタ設定
# ===========================
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
*.swo
settings.json
state.json

# ===========================
# 環境変数（パスワードや APIキーなど、絶対にコミットしない）
# ===========================
.env
.env.local
.env.*.local

# ===========================
# Java / Spring Boot (Maven & Gradle)
# ===========================
target/
build/
out/
*.class
*.jar
*.war
*.ear
hs_err_pid*
.gradle/
gradle-app.setting

# ===========================
# Node.js / React (フロントエンド)
# ===========================
node_modules/
dist/
.next/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===========================
# Python（将来 ml/ ディレクトリで使う）
# ===========================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/

# ===========================
# ログ・一時ファイル
# ===========================
*.log
*.tmp
tmp/

# ===========================
# Claude / MCP 設定（ローカル専用・コミットしない）
# ===========================
.mcp.json
.claude/

# ===========================
# ガントチャート生成用の一時作業ディレクトリ（成果物は docs/*.xlsx）
